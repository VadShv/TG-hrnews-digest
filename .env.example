# ── Database (Postgres + pgvector) ──
DATABASE_URL="postgresql://hrpulse:hrpulse@localhost:5432/hrpulse?schema=public"

# ── Auth (next-auth) ──
NEXTAUTH_SECRET="change-me-to-a-32+char-random-string"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@hrpulse.io"
ADMIN_PASSWORD="change-me"

# ── LLM (Cloud.ru OpenAI-compatible endpoint) ──
LLM_BASE_URL="https://llm.cloud.ru/v1"
LLM_API_KEY="your-cloud-ru-api-key"
LLM_MODEL="gpt-4o-mini"
LLM_EMBED_MODEL="text-embedding-3-small"
EMBED_DIM="4096"

# ── RSSHub ──
RSSHUB_BASE_URL="http://localhost:1200"

# ── Telegram worker (kurigram) ──
TG_WORKER_URL="http://localhost:8001"
APP_ENCRYPTION_KEY="32-byte-hex-or-base64-encryption-key"

# ── App ──
NODE_ENV="production"
